LLM_PROVIDER=llama_cpp

LLAMA_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_API_KEY=local-key
LLAMA_MODEL_ALIAS=LFM2.5-350M-Q4_K_M.gguf
LLAMA_SERVER_BIN=/home/ubuntu/llama.cpp/build/bin/llama-server
LLAMA_MODEL_PATH=/home/ubuntu/models/lfm2.5-350m/LFM2.5-350M-Q4_K_M.gguf
LLAMA_THREADS=4
LLAMA_CTX=2048
LLAMA_PARALLEL=1
LLAMA_LOG_FILE=/tmp/miniqhali/llama-server.log
LLAMA_MAX_TOKENS=192
LLAMA_TEMP=0.2
LLAMA_TOP_K=40
LLAMA_TOP_P=0.9
LLAMA_REPEAT_PENALTY=1.08

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=hf.co/LiquidAI/LFM2.5-350M-GGUF:Q4_K_M
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_K=50
OLLAMA_REPEAT_PENALTY=1.05
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=192
OLLAMA_MAX_PROTOCOL_CHARS=8000

TTS_BACKEND=espeak
TTS_CACHE_ENABLED=true
TTS_CACHE_DIR=/tmp/miniqhali/cache/tts
TTS_SOX_ENABLED=true
TTS_SAMPLE_RATE=22050
TTS_SOX_PITCH_CENTS=350
TTS_SOX_TEMPO=0.94

PIPER_MODEL=/home/ubuntu/models/piper/es_ES-davefx-medium/es_ES-davefx-medium.onnx
PIPER_CONFIG=/home/ubuntu/models/piper/es_ES-davefx-medium/es_ES-davefx-medium.onnx.json
ESPEAK_VOICE=es-la+f4
ESPEAK_FALLBACK_VOICE=es+f3
ESPEAK_SPEED=128
ESPEAK_PITCH=82
ESPEAK_AMP=145
ESPEAK_GAP=4
